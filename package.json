{
  "name": "analog-books",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "node dist/analog/server/index.mjs",
    "typecheck": "ngc --noEmit -p tsconfig.app.json",
    "deploy:vercel": "vercel deploy --prod --yes",
    "deploy:netlify": "NETLIFY=1 pnpm build && npx --yes netlify-cli deploy --prod --no-build",
    "deploy:cloudflare": "BUILD_PRESET=cloudflare-module pnpm build && wrangler deploy",
    "preview:cloudflare": "BUILD_PRESET=cloudflare-module pnpm build && wrangler dev"
  },
  "private": true,
  "dependencies": {
    "@analogjs/router": "^3.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@neondatabase/serverless": "^1.2.1",
    "@netlify/blobs": "^11.1.12",
    "@vercel/functions": "^3.11.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "h3": "^1.15.11",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "thumbhash": "^0.1.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^3.0.0",
    "@analogjs/vite-plugin-angular": "^3.0.0",
    "@analogjs/vite-plugin-nitro": "^3.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.12.0",
    "nitropack": "2.14.0",
    "rollup": "^4.40.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "wrangler": "^4.162.0"
  },
  "packageManager": "pnpm@10.33.0"
}
